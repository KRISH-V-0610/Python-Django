SECRET_KEY=change-me
DEBUG=True

# Django app database (PostgreSQL from docker-compose.yml, host port 5435)
DB_NAME=django_poc4
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5435
# optional, defaults to PostgreSQL
# DB_ENGINE=django.db.backends.postgresql

# Temporal server (docker-compose.yml: gRPC 7233, Web UI 8233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# orders with a total at or above this value wait for a manual "approve" signal
ORDER_APPROVAL_THRESHOLD=1000
