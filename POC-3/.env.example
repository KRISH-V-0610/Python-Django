# Copy to .env (cp .env.example .env). Never commit the real .env.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose, host port 5434)
DB_NAME=django_poc3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

# Redis (docker compose)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry: otlp (send to Jaeger) | console (print spans) | none
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
